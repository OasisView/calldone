# Frontend (Vite, public, baked into bundle)
# These are the ONLY two VITE_-prefixed vars permitted anywhere (security.md §3.2).
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Backend secrets (Supabase Edge Function env, NEVER prefixed VITE_).
# Set these in the Supabase dashboard / `supabase secrets set`, not in this file
# at runtime. Listed here only for reference of what edge functions will need.
#
# Secrets (security.md §3.1):
#   GEMINI_API_KEY=            # gemini-conversation
#   GROQ_API_KEY=              # whisper-transcribe
#   ELEVENLABS_API_KEY=        # elevenlabs-tts
#   BLAND_WEBHOOK_SECRET=      # SET in this slice — authenticates the simulated
#                              #   demo webhook (security.md §4); openssl rand -hex 32
#   RESEND_API_KEY=            # email + .ics to authed users with an email
#
# Non-secret edge configuration (security.md §3.1):
#   ALLOWED_ORIGINS=           # comma-separated CORS allowlist
#                              #   http://localhost:5173,http://127.0.0.1:5173,<prod>
#   CALLS_ENABLED=             # operational kill switch read by make-call
#                              #   (NOT the real-call guard — that is by absence of code, R12)
#   DEMO_SIMULATION_DELAY_SECONDS=  # delay before the simulated webhook fires (default 30)
#
# INTENTIONALLY UNSET in this slice (P6 only — do not add, R12 / R19):
#   BLAND_API_KEY             # never set, never referenced in code (CI grep gate)
#   TWILIO_ACCOUNT_SID        # SMS no-ops while unset; demo calls never send SMS
#   TWILIO_AUTH_TOKEN
#   TWILIO_PHONE_NUMBER
#   TWILIO_VERIFY_SERVICE_SID
#
# Platform-injected into the edge runtime automatically (do not set by hand):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
