# Frontend (Vite, public, baked into bundle)
# These are the ONLY two VITE_-prefixed vars permitted anywhere (security.md §3.2).
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Backend secrets (Supabase Edge Function env, NEVER prefixed VITE_).
# Set these in the Supabase dashboard / `supabase secrets set`, not in this file
# at runtime. Listed here only as the contract of what edge functions need.
# Canonical list: ENV_KEYS in supabase/functions/_shared/api-types.ts.
#
# Secrets (Checkpoint 3, R25/R28):
#   GEMINI_API_KEY=            # agent-brain (Gemini is the conversation brain)
#   RESEND_API_KEY=            # staff summary email + .ics           [SET 2026-07-06]
#   PROVIDER_WEBHOOK_SECRET=   # provider-webhook adapter auth; openssl rand -hex 32
#   BRAIN_SECRET=              # x-calldone-brain-secret header value the voice
#                              #   provider sends to agent-brain; openssl rand -hex 32
#
# Non-secret edge configuration:
#   CALLS_ENABLED=             # R28 GLOBAL kill switch ("true"/"false"); per-org
#                              #   switch is orgs.calls_enabled in the DB
#   ALLOWED_ORIGINS=           # comma-separated CORS allowlist for any future
#                              #   browser-called function (both v1 functions are
#                              #   server-to-server; browsers get no CORS grant)
#
# RETIRED at Checkpoint 3 (consumer-outbound slice — do not set):
#   GROQ_API_KEY, ELEVENLABS_API_KEY   # provider absorbs STT/TTS (R25)
#   BLAND_WEBHOOK_SECRET, DEMO_SIMULATION_DELAY_SECONDS
#
# INTENTIONALLY UNSET (money-gated / deferred):
#   BLAND_API_KEY, TWILIO_*    # no direct-carrier code in v1 (R25: managed
#                              #   inbound; Twilio-direct is a post-launch checkpoint)
#
# Platform-injected into the edge runtime automatically (do not set by hand):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
